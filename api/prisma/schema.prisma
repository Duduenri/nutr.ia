generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  FEMALE
  MALE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum EntrySource {
  PHOTO
  TEXT
  VOICE
  BARCODE
  SEARCH
  MANUAL
  RECIPE
  SUPPLEMENT
  FAVORITE
}

enum FoodSource {
  TACO
  OPEN_FOOD_FACTS
  CUSTOM
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  name               String
  sex                Sex?
  birthDate          DateTime?      @db.Date
  heightCm           Float?
  activityLevel      ActivityLevel?
  goal               Goal?
  startWeightKg      Float?
  targetWeightKg     Float?
  targetDate         DateTime?      @db.Date
  fastingPlan        String?
  petName            String?
  bariatric          Boolean        @default(false)
  surgeryDate        DateTime?      @db.Date
  surgeryType        SurgeryType?
  timezone           String?
  waterReminder      Boolean        @default(false)
  waterReminderStart String         @default("08:00")
  waterReminderEnd   String         @default("22:00")
  waterReminderEvery Int            @default(120)
  mealReminders      Boolean        @default(true)
  exerciseCredit     Int            @default(100)
  friendCode         String?        @unique
  shareWeight        Boolean        @default(false)
  kcalTarget         Int?
  proteinTarget      Int?
  carbsTarget        Int?
  fatTarget          Int?
  fiberTarget        Int?
  waterTargetMl      Int?
  cupSizeMl          Int            @default(250)
  stepsToken         String         @unique @default(cuid())
  createdAt          DateTime       @default(now())

  entries             MealEntry[]
  waterLogs           WaterLog[]
  weightLogs          WeightLog[]
  activities          Activity[]
  steps               DailySteps[]
  notes               Note[]
  messages            ChatMessage[]
  plans               Plan[]
  photos              Photo[]
  foods               Food[]
  fasts               Fast[]
  recipes             Recipe[]
  gemTxs              GemTx[]
  achievements        UserAchievement[]
  items               UserItem[]
  supplements         Supplement[]
  supplementLogs      SupplementLog[]
  sentFriendships     Friendship[]       @relation("requester")
  receivedFriendships Friendship[]       @relation("addressee")
  sentCheers          Cheer[]            @relation("cheerFrom")
  receivedCheers      Cheer[]            @relation("cheerTo")
  challengesSent      Challenge[]        @relation("challengeFrom")
  challengesReceived  Challenge[]        @relation("challengeTo")
  labExams            LabExam[]
  labResults          LabResult[]
  documents           UserDocument[]
  pushSubscriptions   PushSubscription[]
  reminderLogs        ReminderLog[]
  savedMeals          SavedMeal[]
  bodyMeasures        BodyMeasure[]
  progressPhotos      ProgressPhoto[]
  shoppingLists       ShoppingList[]
}

model Food {
  id         String     @id @default(cuid())
  name       String
  searchName String
  category   String?
  source     FoodSource
  barcode    String?
  brand      String?
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcal       Float
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float?
  micros     Json?
  servingG   Float?
  createdAt  DateTime   @default(now())

  entries MealEntry[]

  @@index([barcode])
  @@index([userId])
  @@index([searchName])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  entries      MealEntry[]
  chatMessages ChatMessage[]

  @@index([userId, createdAt])
}

model MealEntry {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  meal      MealType
  name      String
  grams     Float
  kcal      Float
  protein   Float
  carbs     Float
  fat       Float
  fiber     Float?
  micros    Json?
  source    EntrySource
  foodId    String?
  food      Food?       @relation(fields: [foodId], references: [id], onDelete: SetNull)
  photoId   String?
  photo     Photo?      @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([userId, date])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  ml        Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kg        Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Activity {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  name       String
  minutes    Int
  kcal       Int
  intensity  Intensity?
  details    String?
  distanceKm Float?
  exercises  Json?
  createdAt  DateTime   @default(now())

  @@index([userId, date])
}

enum Intensity {
  LIGHT
  MODERATE
  VIGOROUS
}

model DailySteps {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  steps  Int

  @@id([userId, date])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  text      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          ChatRole
  content       String
  photoId       String?
  photo         Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  proposal      Json?
  proposalState String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model Plan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  content   String
  previous  String?
  structure Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Fast {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime
  goalHours Int
  endAt     DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, startAt])
}

model Recipe {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  emoji       String
  meal        MealType
  prepMinutes Int
  servings    Int
  servingG    Float
  kcal        Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float
  ingredients Json
  steps       Json
  tip         String?
  favorite    Boolean  @default(false)
  custom      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model GemTx {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refKey    String
  createdAt DateTime @default(now())

  @@unique([userId, refKey])
  @@index([userId, createdAt])
}

model UserAchievement {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())
  seen       Boolean  @default(false)

  @@id([userId, key])
}

model UserItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  equipped  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([userId, itemId])
}

model Supplement {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  emoji       String
  dose        String?
  proteinG    Float?
  kcal        Float?
  timesPerDay Int             @default(1)
  times       String[]        @default([])
  createdAt   DateTime        @default(now())
  logs        SupplementLog[]

  @@index([userId])
}

model SupplementLog {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  takenAt      DateTime
  mealEntryId  String?

  @@index([userId, date])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Cheer {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("cheerFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("cheerTo", fields: [toId], references: [id], onDelete: Cascade)
  emoji     String
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([toId, seen])
  @@index([fromId, createdAt])
}

enum SurgeryType {
  BGA
  SLEEVE
  BYPASS
  BPD_DS
}

model LabExam {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedAt DateTime    @db.Date
  title       String
  filePath    String?
  createdAt   DateTime    @default(now())
  results     LabResult[]

  @@index([userId, collectedAt])
}

model LabResult {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId   String?
  exam     LabExam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  date     DateTime @db.Date
  code     String
  name     String
  category String
  value    Float
  unit     String
  refLow   Float?
  refHigh  Float?
  refText  String?
  status   String

  @@unique([userId, code, date])
  @@index([userId, code])
}

model UserDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ReminderLog {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementId String
  date         DateTime @db.Date
  time         String
  sentAt       DateTime @default(now())

  @@id([userId, supplementId, date, time])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
  FAILED
}

model Challenge {
  id          String          @id @default(cuid())
  fromId      String
  from        User            @relation("challengeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          User            @relation("challengeTo", fields: [toId], references: [id], onDelete: Cascade)
  title       String
  stake       Int
  deadline    DateTime
  status      ChallengeStatus @default(PENDING)
  winnerId    String?
  proof       String?
  createdAt   DateTime        @default(now())
  respondedAt DateTime?
  resolvedAt  DateTime?

  @@index([fromId, status])
  @@index([toId, status])
}

model SavedMeal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  meal      MealType?
  items     Json
  createdAt DateTime  @default(now())

  @@index([userId])
}

model BodyMeasure {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  waistCm    Float?
  hipCm      Float?
  chestCm    Float?
  armCm      Float?
  thighCm    Float?
  bodyFatPct Float?
  createdAt  DateTime @default(now())

  @@unique([userId, date])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  path      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
