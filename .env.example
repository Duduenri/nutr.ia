# Senha do Postgres (gere uma: openssl rand -hex 16)
POSTGRES_PASSWORD=
# Segredo do login (gere um: openssl rand -hex 32)
JWT_SECRET=
# Código pedido no cadastro — só quem souber cria conta
INVITE_CODE=
# Chave da API da OpenAI: platform.openai.com → API keys
OPENAI_API_KEY=
# Modelo da OpenAI (precisa ter visão, saída estruturada e raciocínio)
OPENAI_MODEL=gpt-5.6-luna
# true quando o site estiver em HTTPS (recomendado), false se for http puro
COOKIE_SECURE=true
# Porta do site na VPS. Com o Caddy (HTTPS) use 127.0.0.1:8080 para não expor HTTP puro
WEB_PORT=8080
# Para o app subir o próprio Caddy (servidor sem proxy): COMPOSE_PROFILES=https
COMPOSE_PROFILES=
# Só para o perfil https (Caddy gera o certificado sozinho): domínio(s) apontando pra VPS, separados por vírgula
DOMAIN=
# Notificações (lembretes). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
